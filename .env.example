# AICF v2 Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="AICF - AI Content Factory"
APP_VERSION="2.0.0"
DEBUG=false
ENVIRONMENT="development"  # development, staging, production

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# PostgreSQL connection string
DATABASE_URL="postgresql://aicf:aicf_password@localhost:5432/aicf_db"

# Log SQL queries (true for development, false for production)
DB_ECHO=false

# =============================================================================
# AI PROVIDER SETTINGS
# =============================================================================
# Primary AI provider (openai, anthropic, ollama)
AI_PROVIDER="openai"

# API Keys (never commit real keys to version control)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Model settings
DEFAULT_MODEL="gpt-4o-mini"
MAX_TOKENS=4096
TEMPERATURE=0.7

# =============================================================================
# STORAGE SETTINGS
# =============================================================================
STORAGE_PATH="./storage"
MAX_UPLOAD_SIZE_MB=500

# S3 Configuration (optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY=""  # Generate with: openssl rand -hex 32
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8501"]'

# =============================================================================
# WORKFLOW SETTINGS
# =============================================================================
MAX_CONCURRENT_WORKFLOWS=5
WORKFLOW_TIMEOUT_MINUTES=60

# =============================================================================
# MEMORY SETTINGS
# =============================================================================
MEMORY_ENABLED=true
MEMORY_RETENTION_DAYS=90

# =============================================================================
# AUDIT LOGGING
# =============================================================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
