```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map
*.jsx.map
*.tsx.map

# Environment variables
.env
.env.local
*.env.*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.Python
env/
venv/
.venv/
.python-version
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.nox/
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
cython_debug/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
jspm_packages/
web_modules/
*.tsbuildinfo
.next/
.nuxt/
.vuepress/dist
.static
.nuxt
.dist

# Build artifacts
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Compression
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
desktop.ini

# Testing
coverage/
*.cover
.hypothesis/
cover/

# Temporary folders
tmp/
temp/
```

